{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "description": "__MSG_ext_description__",
  "version": "1.0.0",
  "default_locale": "en",
  "permissions": ["downloads", "contextMenus", "storage", "notifications"],
  "host_permissions": ["http://192.168.1.29:8000/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "action.html",
    "default_icon": {
      "16": "icons/lid-16.png",
      "48": "icons/lid-48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/lid-16.png",
    "48": "icons/lid-48.png",
    "128": "icons/lid-128.png"
  }
}
